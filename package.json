{
  "name": "pure-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal composable agent loop with an explicit deterministic demo TUI",
  "engines": {
    "node": ">=24.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "start": "node src/cli.ts",
    "demo": "node src/cli.ts --demo",
    "example": "node examples/basic.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "test:package": "npm run build && node --test --test-concurrency=1 test/package.test.mjs test/workspace-reader-package.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.5.0",
    "ajv": "8.20.0",
    "openai": "7.47.0",
    "string-width": "8.3.0"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "pure-agent": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/*.md",
    "docs/*.svg"
  ]
}
