{
  "name": "pure-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Composable developer agent SDK and terminal with explicit local tools and optional Web/MCP adapters",
  "engines": {
    "node": ">=24.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./runtime": {
      "types": "./dist/developer-agent.d.ts",
      "import": "./dist/developer-agent.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./tools/filesystem": {
      "types": "./dist/tools/filesystem.d.ts",
      "import": "./dist/tools/filesystem.js"
    },
    "./tools/process": {
      "types": "./dist/tools/process.d.ts",
      "import": "./dist/tools/process.js"
    },
    "./extensions/mcp": {
      "types": "./dist/extensions/mcp.d.ts",
      "import": "./dist/extensions/mcp.js"
    },
    "./extensions/web": {
      "types": "./dist/extensions/web.d.ts",
      "import": "./dist/extensions/web.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "test": "node scripts/refuse-legacy-verification.mjs",
    "start": "node src/cli.ts",
    "example": "node examples/basic.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/refuse-legacy-verification.mjs",
    "build": "node scripts/build.mjs",
    "test:package": "node scripts/refuse-legacy-verification.mjs",
    "prepack": "npm run build",
    "quality": "biome ci --error-on-warnings src && biome ci --error-on-warnings test && biome ci --error-on-warnings examples && biome ci --error-on-warnings .",
    "check:static": "npm run quality && npm run typecheck && npm run build",
    "test:nonmodel": "node --test test/filesystem.test.ts test/verification-entrypoints.test.mjs test/snapshot-data-validation.test.ts test/context-projection-data.test.ts test/tool-authorization.test.ts test/tool-execution.test.ts test/checkpoint.test.ts test/run-journal.test.ts",
    "test:package:nonmodel": "npm run build && node --test test/package-nonmodel.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "@types/picomatch": "4.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.5.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ignore": "7.0.14",
    "openai": "7.47.0",
    "parse5": "8.1.0",
    "picomatch": "4.0.7",
    "string-width": "8.3.0"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "pure": "./dist/cli.js",
    "pure-agent": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/*.md",
    "docs/*.svg"
  ]
}
