{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.mjs",
      "test/**/*.ts",
      "test/**/*.mjs",
      "examples/**/*.ts",
      "examples/**/*.mjs",
      "*.json",
      "*.mjs",
      "*.ts",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/artifacts",
      "!!**/.private",
      "!!**/.env*",
      "!!package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
